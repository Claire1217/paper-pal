# Paper Pal environment file.
#
# Copy this file to ".env" in the same folder (next to package.json) and fill
# in only what you need. ".env" is git-ignored. Paper Pal loads it when the
# server, "npm run doctor" and "npm run setup" start. Variables that are
# already set in your shell win over this file.
#
# API keys belong here and nowhere else: never in a project's .paper-pal.json.
# Every value below is optional. The CLI agents (codex, claude) need none of it.

# --- API providers ----------------------------------------------------------
# A provider is "ready" when its key is set here AND a model is configured in
# the project's .paper-pal.json, e.g.  "openai": { "model": "<model id>" }

# provider "openai"      https://api.openai.com/v1
OPENAI_API_KEY=

# provider "anthropic"   https://api.anthropic.com
ANTHROPIC_API_KEY=

# provider "openrouter"  https://openrouter.ai/api/v1
OPENROUTER_API_KEY=

# provider "deepseek"    https://api.deepseek.com/v1
DEEPSEEK_API_KEY=

# provider "ollama" (http://127.0.0.1:11434/v1) needs no key.

# provider "custom": any OpenAI-compatible endpoint (or Anthropic-compatible
# with "custom": { "protocol": "anthropic" } in .paper-pal.json).
# The base URL is the part before /chat/completions, e.g. https://host/v1
PAPER_PAL_API_BASE_URL=
# Leave empty when the endpoint needs no key.
PAPER_PAL_API_KEY=

# --- Agent CLIs -------------------------------------------------------------
# Full path to the binary when it is not on PATH.
CODEX_BIN=
CLAUDE_BIN=

# --- Server -----------------------------------------------------------------
# Address to listen on. Default 127.0.0.1. The app has no authentication:
# keep the default unless you know exactly why you are changing it.
PAPER_PAL_HOST=
# Port. Default 4317; "--port <n>" on the command line wins; 0 = any free port.
PAPER_PAL_PORT=

# --- Trust switches (leave empty unless you need them) ------------------------
# A project's .paper-pal.json is usually committed with the paper, so by default
# it may not make Paper Pal run arbitrary programs or send your key elsewhere.
# Set a switch to 1 only for projects you wrote or trust.

# Allow latex.command other than latexmk, pdflatex, xelatex, lualatex, tectonic, make.
PAPER_PAL_ALLOW_CUSTOM_LATEX=
# Allow codex.command / claude.command to be a path or contain spaces.
PAPER_PAL_ALLOW_CUSTOM_COMMANDS=
# Allow <provider>.baseUrl in a project file to name a non-local host.
PAPER_PAL_ALLOW_PROJECT_BASE_URL=
# Allow a project file to name ANY environment variable as <provider>.apiKeyEnv
# (default: only provider key variables and PAPER_PAL_*_KEY names).
PAPER_PAL_ALLOW_PROJECT_KEY_ENV=

# --- Rarely needed ----------------------------------------------------------
# Use another env file instead of this one, or "none" to load no file at all.
# (Only meaningful when set in the shell.)
# PAPER_PAL_ENV_FILE=
